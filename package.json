{
  "name": "salento-mapa-turistico",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/fetch-safety-data.mjs",
    "build": "vite build && node scripts/inject-prerender.js",
    "data:refresh": "node scripts/fetch-safety-data.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "seo:generate": "node tools/generate_international_seo_pages.js && node tools/generate_category_pages.js",
    "seo:audit": "python tools/seo_technical_audit.py --output tools/seo_technical_audit.json",
    "seo:enrich": "python tools/enrich_static_seo.py",
    "seo:routes": "python tools/generate_sitemap_route_pages.py",
    "seo:meta": "python tools/optimize_static_meta.py",
    "seo:strategy": "python tools/seo_strategy_analyzer.py --output tools/seo_strategy_report.json",
    "seo:structured": "python tools/enrich_structured_data.py",
    "check:translations": "node check_translations.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.0.0",
    "react-leaflet": "^4.2.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.4",
    "terser": "^5.51.2",
    "typescript": "^5.5.3",
    "vitest": "^5.1.0"
  },
  "description": "**Plataforma oficial de turismo de Salento, Quindío**   **Información verificada en tiempo real contra desinformación**   **Versión:** 0.1.0 | **Estado:** 🟢 PRODUCCIÓN READY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dphack1987/mapa-digital-salento.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dphack1987/mapa-digital-salento/issues"
  },
  "homepage": "https://github.com/dphack1987/mapa-digital-salento#readme"
}
