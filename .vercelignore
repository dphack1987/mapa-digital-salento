# Archivos y directorios a ignorar en Vercel
# IMPORTANTE: NO incluir 'dist' aquí - Vercel lo necesita para el deploy
# vercel.json configura outputDirectory: "dist"
node_modules
.DS_Store
.git
.gitignore
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode
.idea
*.log